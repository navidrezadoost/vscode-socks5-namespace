# Example OpenVPN Configuration Template
# Copy this file and customize it for your VPN provider

# Basic settings
client
dev tun
proto udp
remote your-vpn-server.com 1194

# Certificates and keys
# Uncomment and set paths to your certificate files
# ca /path/to/ca.crt
# cert /path/to/client.crt
# key /path/to/client.key

# Or use inline certificates (recommended for portability)
# <ca>
# -----BEGIN CERTIFICATE-----
# Your CA certificate here
# -----END CERTIFICATE-----
# </ca>
#
# <cert>
# -----BEGIN CERTIFICATE-----
# Your client certificate here
# -----END CERTIFICATE-----
# </cert>
#
# <key>
# -----BEGIN PRIVATE KEY-----
# Your private key here
# -----END PRIVATE KEY-----
# </key>

# Security settings
remote-cert-tls server
cipher AES-256-GCM
auth SHA256

# Connection settings
resolv-retry infinite
nobind
persist-key
persist-tun

# Compression (optional, may improve performance)
comp-lzo

# Logging
verb 3
mute 20

# For systems with restricted privileges
# user nobody
# group nogroup

# Additional security
# tls-auth /path/to/ta.key 1

# If your VPN provider uses username/password authentication
# auth-user-pass /path/to/auth.txt
# Create auth.txt with:
#   Line 1: username
#   Line 2: password
